# Copy to .env.local for local development. Never commit real values.

# Canonical site URL (no trailing slash). Used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://hnrykola.netlify.app

# Contact form (server-only). Without RESEND_API_KEY the form offers a pre-filled email instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=henrykay53@gmail.com
# Must be a sender Resend allows. onboarding@resend.dev only delivers to the Resend account's own email.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
